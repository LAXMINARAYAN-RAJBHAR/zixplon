{
  "functions": {
    "api/call-token.js": {
      "includeFiles": "node_modules/livekit-server-sdk/**"
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/manage-admin", "destination": "/api/admin?action=manage-admin" },
    { "source": "/api/moderate-user", "destination": "/api/admin?action=moderate-user" },
    { "source": "/api/manage-home-hub-tabs", "destination": "/api/admin?action=manage-home-hub-tabs" },
    { "source": "/api/upload", "destination": "/api/files?action=upload" },
    { "source": "/api/upload-url", "destination": "/api/files?action=upload-url" },
    { "source": "/api/process-bill-payment", "destination": "/api/payments?action=process-bill-payment" },
    { "source": "/api/process-recharge", "destination": "/api/payments?action=process-recharge" },
    { "source": "/s/:type/:id", "destination": "/api/og?type=:type&id=:id" },
    {
      "source": "/((?!api/|static/|version\\.json|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}